# EnergyPulse Configuration
# Copy this file to .env and fill in your credentials.
# The .env file is ignored by git — never commit real credentials.

# ---------------------------------------------------------------------------
# EMAIL — option A (recommended, no signup): Gmail SMTP with an app password
#   To create the app password:
#     1. Google Account -> Security -> 2-Step Verification  (turn it ON)
#     2. Google Account -> Security -> App Passwords -> "Mail"
#     3. Copy the 16-character app password into SMTP_PASSWORD below
#   NOTE: the exact variable names the app reads are SMTP_USERNAME /
#   SMTP_PASSWORD / SMTP_HOST / SMTP_PORT (not SMTP_USER).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# Optional: the "From" address. Leave blank to send from SMTP_USERNAME.
SMTP_FROM=

# ---------------------------------------------------------------------------
# EMAIL — option B (alternative): SendGrid
#   Use EITHER this OR the SMTP section above, not both.
#   Create a free account at sendgrid.com and paste the API key here.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ---------------------------------------------------------------------------
# SMS (optional, future step) — Twilio
#   Leaving these blank is fine: SMS stays "Not configured" in the app.
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890